{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "ignorePatterns": ["dist", "node_modules", "src/api/schema.d.ts"],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "no-underscore-dangle": "off"
  }
}
