{
  "name": "Twitch Points Miner",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "serayuzgur.crates",
        "oxc.oxc-vscode",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "rust-analyzer.check.command": "clippy",
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer",
          "editor.formatOnSave": true
        },
        "[typescript]": {
          "editor.defaultFormatter": "oxc.oxc-vscode",
          "editor.formatOnSave": true
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "oxc.oxc-vscode",
          "editor.formatOnSave": true
        }
      }
    }
  },
  "forwardPorts": [3000, 5173],
  "mounts": [
    "source=${localWorkspaceFolder}/data,target=/workspaces/twitch-points-miner/data,type=bind,consistency=cached",
    // Keep cargo's target/ out of the bind mount: it stops host-built and
    // container-built artifacts from fighting over ownership, and bind mounts
    // are slow for the thousands of small files cargo writes.
    "source=tpm-cargo-target,target=/workspaces/twitch-points-miner/target,type=volume"
  ],
  "remoteEnv": {
    "TZ": "Europe/Vienna",
    "LOG": "debug",
    "RUST_BACKTRACE": "1"
  }
}
